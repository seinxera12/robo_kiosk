# Frontend runtime config. Copy to `.env` for local dev.
#
# The deployed voice-server sits behind a Tailscale Funnel: a single TLS origin
# fronts the whole service, so /ws and /health share one host and one port.
# Must be wss:// (not ws://) — the funnel is TLS-only. CORS is open.
#
# Production values live in .env.production and are baked into the packaged exe;
# this file is for pointing a dev build at a server by hand.

# WebSocket endpoint — carries the entire API (control JSON + audio both ways).
VITE_SERVER_WS_URL=wss://ubuntu.tailcd8da4.ts.net:8443/ws

# Health endpoint — polled for readiness before the mic is enabled.
VITE_HEALTH_URL=https://ubuntu.tailcd8da4.ts.net:8443/health

# Kiosk identity sent in session_start.
VITE_KIOSK_ID=kiosk-01
VITE_KIOSK_LOCATION=Floor 1 Lobby

# --- Local backend instead of the funnel -------------------------------------
# When running the voice-server on your own machine it serves WS and health on
# plain HTTP. Mic capture still works because localhost is a secure context.
#
# VITE_SERVER_WS_URL=ws://localhost:8765/ws
# VITE_HEALTH_URL=http://localhost:8765/health
