# Frontend runtime config (FE-1, plan §3). All optional — sensible defaults are
# derived from window.location / localhost when unset.

# WebSocket endpoint for the voice server (default: ws://<host>:8765/ws)
VITE_SERVER_WS_URL=ws://localhost:8765/ws

# Health endpoint (default: http://<host>:8000/health)
VITE_HEALTH_URL=http://localhost:8000/health

# Kiosk identity sent in session_start
VITE_KIOSK_ID=kiosk-01
VITE_KIOSK_LOCATION=Floor 1 Lobby
