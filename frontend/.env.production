# Production config — BAKED INTO THE BUILD.
#
# `vite build` loads this file automatically (mode=production) and inlines these
# values into dist/. The packaged launcher exe therefore ships pointing at this
# server: changing it requires a rebuild + redistribution of the exe.
#
# The voice-server is reachable ONLY through the Tailscale Funnel. One origin
# fronts everything — /ws and /health share the same host and port, and the
# scheme must be TLS (wss:// / https://). Plain ws:// will be rejected.

VITE_SERVER_WS_URL=wss://ubuntu.tailcd8da4.ts.net:8443/ws
VITE_HEALTH_URL=https://ubuntu.tailcd8da4.ts.net:8443/health

# Kiosk identity sent in session_start; feeds the assistant's system prompt.
VITE_KIOSK_ID=kiosk-01
VITE_KIOSK_LOCATION=Floor 1 Lobby
